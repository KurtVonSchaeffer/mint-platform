# Supabase (required — one project per client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Tenant branding (override defaults)
VITE_COMPANY_NAME=AlgoLend
VITE_PRIMARY_COLOR=#7C3AED
VITE_SECONDARY_COLOR=#1A1F36
VITE_LOGO_URL=
VITE_COMPANY_NCR=NCRCP00000

# Kill switch — set to false to show maintenance page
VITE_PLATFORM_ACTIVE=true

# Feature flags (JSON — set per client)
VITE_FEATURES={"open_banking":true,"sacrra_bureau":true,"credit_scoring":true,"e_contracts":true,"multi_branch":false,"whatsapp_comms":false,"biometric_kyc":false}

# API base (leave empty for same origin, or set to Express server URL in dev)
VITE_API_URL=http://localhost:5000
