{
  "framework": "nextjs",
  "buildCommand": "pnpm --filter './apps/mint-admin' run build",
  "outputDirectory": "apps/mint-admin/.next",
  "crons": [
    {
      "path": "/api/billing/cron",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/monthly-statements",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/cron/follow-up-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/stale-leads",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/biztech/invoices/reminders-cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/biztech/recurring-invoices/cron",
      "schedule": "0 6 * * *"
    }
  ]
}
